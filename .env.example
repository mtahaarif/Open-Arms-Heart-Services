# Public URL of the deployed site (used for SEO metadata, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact & careers forms are delivered by email through Resend (https://resend.com).
# Without these two values the forms tell visitors to call instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: verified sender, e.g. "Open Arms Website <website@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Optional: Google Search Console HTML-tag verification code (content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: Google Tag Manager container, e.g. GTM-XXXXXXX (also opens the CSP for GTM/GA)
NEXT_PUBLIC_GTM_ID=
